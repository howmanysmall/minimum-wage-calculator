		"@happy-dom/global-registrator": "^20.9.0",
		"@oxc-project/types": "^0.132.0",
		"@oxlint/plugins": "^1.66.0",
		"@rolldown/plugin-babel": "^0.2.3",
		"@tailwindcss/vite": "^4.3.0",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/babel__core": "^7.20.5",
		"@types/node": "^25.9.1",

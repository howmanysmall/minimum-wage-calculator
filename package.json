{
	"name": "minimum-wage-calculator",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"biome": "biome",
		"build": "nr type-check && vite build",
		"build:oxc": "jiti ./scripts/build-small-rules.ts",
		"dev": "vite",
		"format": "bash -c 'a=$(bash scripts/default-paths.sh \"$@\"); nr oxfmt --no-error-on-unmatched-pattern $a && nr biome check --no-errors-on-unmatched --write $a' _",
		"knip": "knip-bun",
		"lint": "bash -c 'a=$(bash scripts/default-paths.sh \"$@\"); nr oxc --no-error-on-unmatched-pattern $a && nr biome check --no-errors-on-unmatched $a' _",
		"oxc": "oxlint",
		"oxfmt": "oxfmt",
		"prepare": "lefthook install",
		"preview": "vite preview",
		"publish:pages": "bash scripts/publish-pages.sh",
		"skills": "skills",
		"test": "vitest run",
		"test:watch": "vitest",
		"tsgo": "tsgo",
		"type-check": "tsgo --build",
		"update-snapshots": "jiti scripts/update-snapshots.ts"
	},
	"dependencies": {
		"arktype": "^2.2.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.575.0",
		"radix-ui": "^1.4.3",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@antfu/ni": "30.1.0",
		"@babel/core": "^7.29.0",
		"@biomejs/biome": "^2.4.15",

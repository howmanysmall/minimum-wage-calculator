		"babel-plugin-react-compiler": "^1.0.0",
		"colorette": "^2.0.20",
		"commitlint": "^21.0.1",
		"consola": "^3.4.2",
		"dotenv": "^17.4.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-regexp": "^3.1.0",
		"eslint-plugin-sonarjs": "^4.0.3",
		"eslint-plugin-testing-library": "^7.16.2",
